{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/unit/main/**/*",
    "tests/unit/shared/**/*",
    "tests/helpers/**/*",
    "tests/e2e/**/*",
    "scripts/**/*",
    "*.config.ts",
    "*.config.js",
    "*.config.mjs"
  ]
}
