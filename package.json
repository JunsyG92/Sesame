{
  "name": "sesame",
  "productName": "Sesame",
  "version": "0.1.0",
  "description": "Quick-launcher password manager, 100% compatible with the standard unix password store (pass).",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Sesame contributors",
    "email": "sesame@users.noreply.github.com"
  },
  "homepage": "https://www.passwordstore.org/",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "licenses": "node scripts/check-licenses.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.3.0",
    "@zxcvbn-ts/language-common": "^4.2.0",
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "i18next": "^27.2.4",
    "jsqr": "^1.4.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.28",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "fast-check": "^4.11.0",
    "fuse.js": "^7.5.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --check"
  }
}
